    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": 1,
        "title": "Schema Version",
        "type": "integer"
      }
    },
    "required": [
      "schema_version"
    ],
    "title": "BootstrapRequest",
    "type": "object"
  },
  "DemoCreateDTO": {
    "$id": "urn:deykit:transport:DemoCreateDTO",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "demo": {
        "$ref": "urn:deykit:transport:DemoSummaryDTO#"
      },
      "registration": {
        "$ref": "urn:deykit:transport:RegistrationDTO#"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      }
    },
    "required": [
      "demo",
      "registration",
      "schema_version"
    ],
    "title": "DemoCreateDTO",
    "type": "object"
  },
  "DemoCreateRequest": {
    "$id": "urn:deykit:transport:DemoCreateRequest",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "operation_id": {
        "title": "Operation Id",
        "type": "string"
      },
      "path": {
        "minLength": 1,
        "title": "Path",
        "type": "string"
      },
      "schema_version": {
        "const": 1,
        "title": "Schema Version",
        "type": "integer"
      }
    },
    "required": [
      "operation_id",
      "path",
      "schema_version"
    ],
    "title": "DemoCreateRequest",
    "type": "object"
  },
  "DemoSummaryDTO": {
    "$id": "urn:deykit:transport:DemoSummaryDTO",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "binding_count": {
        "pattern": "^(?:0|[1-9][0-9]*)$",
        "title": "Binding Count",
        "type": "string"
      },
      "case_count": {
        "pattern": "^(?:0|[1-9][0-9]*)$",
        "title": "Case Count",
        "type": "string"
      },
      "dataset_id": {
        "title": "Dataset Id",
        "type": "string"
      },
      "decision_id": {
        "title": "Decision Id",
        "type": "string"
      },
      "evidence_mode": {
        "const": "authored_fixture",
        "title": "Evidence Mode",
        "type": "string"
      },
      "fixture_set_id": {
        "title": "Fixture Set Id",
        "type": "string"
      },
      "label_count": {
        "pattern": "^(?:0|[1-9][0-9]*)$",
        "title": "Label Count",
        "type": "string"
      },
      "operation_id": {
        "title": "Operation Id",
        "type": "string"
      },
      "profile_id": {
        "title": "Profile Id",
        "type": "string"
      },
      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "replayed": {
        "title": "Replayed",
        "type": "boolean"
      },
      "revision_id": {
        "title": "Revision Id",
        "type": "string"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      }
    },
    "required": [
      "binding_count",
      "case_count",
      "dataset_id",
      "decision_id",
      "evidence_mode",
      "fixture_set_id",
      "label_count",
      "operation_id",
      "profile_id",
      "project_id",
      "replayed",
      "revision_id",
      "schema_version"
    ],
    "title": "DemoSummaryDTO",
    "type": "object"
  },
  "ErrorDTO": {
    "$id": "urn:deykit:transport:ErrorDTO",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "code": {
        "title": "Code",
        "type": "string"
      },
      "correlation_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Correlation Id"
      },
      "message": {
        "title": "Message",
        "type": "string"
      },
      "reason": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Reason"
      },
      "resource_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Resource Id"
      },
      "row": {
        "anyOf": [
          {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Row"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      }
    },
    "required": [
      "code",
      "message",
      "schema_version"
    ],
    "title": "ErrorDTO",
    "type": "object"
  },
  "Failure": {
    "$id": "urn:deykit:transport:Failure",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
