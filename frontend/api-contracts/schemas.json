{
  "BootstrapReply": {
    "$id": "urn:deykit:transport:BootstrapReply",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "api_version": {
        "const": 1,
        "default": 1,
        "title": "Api Version",
        "type": "integer"
      },
      "capability": {
        "pattern": "^[A-Za-z0-9_-]{43}$",
        "title": "Capability",
        "type": "string"
      },
      "origin": {
        "title": "Origin",
        "type": "string"
      }
    },
    "required": [
      "capability",
      "origin"
    ],
    "title": "BootstrapReply",
    "type": "object"
  },
  "BootstrapRequest": {
    "$id": "urn:deykit:transport:BootstrapRequest",
